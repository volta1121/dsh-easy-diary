{
  "name": "dsh-diary",
  "version": "0.2.0",
  "description": "Per-session diary for DeepSeek Harness: every night each configured session writes one entry into its own local markdown file.",
  "author": "Derpyu520",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Derpyu520/dsh-diary.git"
  },
  "homepage": "https://github.com/Derpyu520/dsh-diary",
  "bugs": {
    "url": "https://github.com/Derpyu520/dsh-diary/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "diary",
    "journal",
    "markdown"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "config.example.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "test": "node --test"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
